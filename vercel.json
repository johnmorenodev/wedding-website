{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/upload", "destination": "/upload.html" },
    { "source": "/prenup", "destination": "/prenup.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
